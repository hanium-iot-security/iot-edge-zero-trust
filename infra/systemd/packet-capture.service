[Unit]
Description=IoT Edge Zero Trust - Raspberry Pi #1 Packet Capture Runtime
After=network-online.target systemd-time-wait-sync.service
Wants=network-online.target systemd-time-wait-sync.service

# 짧은 시간에 재시작이 5번을 넘으면 systemd가 더 이상 재시작을 시도하지 않는다.
# (5.4 절: "systemd Start Limit으로 반복 재시작을 제한한다")
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Gateway Metrics 실기기 검증 기록에서 확인된 실제 배포 경로.
# venv, WorkingDirectory 경로는 검증됨. AmbientCapabilities의 tcpdump 상속 여부는 Gateway Metrics가 tcpdump를 쓰지 않으므로 이 검증으로 커버되지 않음 — 별도 확인 필요.
User=pi
Group=pi
WorkingDirectory=/home/pi/iot-edge-zero-trust
EnvironmentFile=-/home/pi/iot-edge-zero-trust/.env

ExecStart=/home/pi/iot-edge-zero-trust/edge/scripts/run_packet_capture.sh

# tcpdump가 root 없이 패킷을 캡처할 수 있도록 최소 권한만 부여한다.
# sudo나 shell=True에 의존하지 않는다 (5.4 절).
#   CAP_NET_RAW   : raw socket으로 패킷을 읽기 위해 필요
#   CAP_NET_ADMIN : promiscuous mode 등 인터페이스 제어에 필요
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

# 비정상 종료 시에만 자동 재시작한다.
# 관리자가 `systemctl stop`으로 정상 중지하면(exit code 0) 재시작하지 않는다.
Restart=on-failure
RestartSec=5

KillMode=mixed
# python이 현재 Window 캡처를 마치고 정상 종료하기까지 걸리는 최대 시간(window_seconds 10초 + SIGTERM 유예 5초)보다 여유 있게 설정한다.
# 이 시간을 넘기면 systemd가 남은 프로세스(tcpdump 포함)를 SIGKILL한다.
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=packet-capture

[Install]
WantedBy=multi-user.target