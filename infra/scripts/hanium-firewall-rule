#!/bin/bash
# Install root:root 0755. Only this wrapper is permitted by sudoers.
# Three arguments retain INPUT/TCP/1883; the optional fourth is a fixed scope.
# Callers cannot select a chain, target, port or binary. Dry run never executes.
set -euo pipefail
IPTABLES=/usr/sbin/iptables
IP=/usr/sbin/ip
PROTECTED_FILE=/etc/hanium/firewall-protected-ipv4.conf
LEGACY=MQTT_IPV4_TCP_1883
WIDE=PI_INPUT_IPV4_ALL

fail() { echo "$1" >&2; exit "${2:-65}"; }
usage() { fail "usage: check|insert|delete <private_ipv4> <positive_rule_id> [MQTT_IPV4_TCP_1883|PI_INPUT_IPV4_ALL]; list" 64; }

validate_private_ipv4() {
    local ip="$1" octet o1 o2 o3 o4
    [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || fail "invalid IPv4"
    o1="${BASH_REMATCH[1]}"; o2="${BASH_REMATCH[2]}"; o3="${BASH_REMATCH[3]}"; o4="${BASH_REMATCH[4]}"
    for octet in "$o1" "$o2" "$o3" "$o4"; do
        [[ "$octet" == 0 || "$octet" != 0* ]] || fail "noncanonical IPv4"
        (( 10#$octet <= 255 )) || fail "invalid IPv4"
    done
    (( o1 == 10 || (o1 == 172 && o2 >= 16 && o2 <= 31) || (o1 == 192 && o2 == 168) )) || fail "private IPv4 required"
}

check_owned_path() {
    local path="$1" owner mode
    [[ ! -L "$path" && -e "$path" ]] || fail "protected configuration unavailable"
    read -r owner mode < <(/usr/bin/stat -c '%u %a' -- "$path")
    [[ "$owner" == 0 ]] && (( (8#$mode & 022) == 0 )) || fail "protected configuration must be root owned and not writable by others"
}

protect_insert() {
    local target="$1" config line count=0 addresses
    if [[ "${HANIUM_FW_DRY_RUN:-0}" == 1 ]]; then
        config="${HANIUM_FW_TEST_PROTECTED_FILE:-}"
        addresses="${HANIUM_FW_TEST_LOCAL_IPV4:-}"
    else
        config="$PROTECTED_FILE"
        check_owned_path /etc
        check_owned_path /etc/hanium
        check_owned_path "$config"
        [[ -f "$config" ]] || fail "protected configuration is not a regular file"
        addresses="$($IP -o -4 addr show)" || fail "local IPv4 observation failed"
        [[ -n "$addresses" ]] || fail "local IPv4 observation unavailable"
        while read -r line; do
            [[ "$line" =~ inet[[:space:]]+([0-9.]+)/ ]] || continue
            [[ "${BASH_REMATCH[1]}" != "$target" ]] || fail "cannot block a local Pi address"
        done <<< "$addresses"
    fi
    if [[ "${HANIUM_FW_DRY_RUN:-0}" == 1 ]]; then
        for line in ${addresses//,/ }; do
            [[ "$line" != "$target" ]] || fail "cannot block a local Pi address"
        done
    fi
    if [[ -n "$config" ]]; then
        [[ -f "$config" && ! -L "$config" ]] || fail "protected configuration unavailable"
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%%#*}"
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            [[ -n "$line" ]] || continue
            validate_private_ipv4 "$line"
            count=$((count+1))
            [[ "$line" != "$target" ]] || fail "protected address cannot be blocked"
        done < "$config"
    fi
    [[ "${HANIUM_FW_DRY_RUN:-0}" == 1 || "$count" -gt 0 ]] || fail "protected configuration has no approved addresses"
}

[[ $# -ge 1 ]] || usage
operation="$1"
case "$operation" in
    check|insert|delete)
        [[ $# -eq 3 || $# -eq 4 ]] || usage
        source_ip="$2"; rule_id="$3"; scope="${4-$LEGACY}"
        [[ "$scope" == "$LEGACY" || "$scope" == "$WIDE" ]] || usage
        validate_private_ipv4 "$source_ip"
        [[ "$rule_id" =~ ^[1-9][0-9]{0,18}$ ]] || fail "invalid rule id"
        [[ ${#rule_id} -lt 19 || "$rule_id" < 9223372036854775808 ]] || fail "invalid rule id"
        [[ "$operation" != insert ]] || protect_insert "$source_ip"
        MATCH_ARGS=(-s "$source_ip" -m comment --comment "hanium-firewall:$rule_id" -j DROP)
        if [[ "$scope" == "$LEGACY" ]]; then
            MATCH_ARGS=(-p tcp -s "$source_ip" --dport 1883 -m comment --comment "hanium-firewall:$rule_id" -j DROP)
        fi
        case "$operation" in
            check) IPTABLES_ARGS=(-C INPUT "${MATCH_ARGS[@]}");;
            insert) IPTABLES_ARGS=(-I INPUT 1 "${MATCH_ARGS[@]}");;
            delete) IPTABLES_ARGS=(-D INPUT "${MATCH_ARGS[@]}");;
        esac
        ;;
    list)
        [[ $# -eq 1 ]] || usage
        IPTABLES_ARGS=(-S INPUT)
        ;;
    *) usage;;
esac
if [[ "${HANIUM_FW_DRY_RUN:-0}" == 1 ]]; then
    printf '%s\n' "${IPTABLES_ARGS[@]}"
    exit 0
fi
exec "$IPTABLES" "${IPTABLES_ARGS[@]}"
