# Backend
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
# Dashboard를 실제로 여는 Origin만 쉼표로 나열합니다.
# 예: http://192.168.0.3:5173
# API_ALLOW_CREDENTIALS=true이면 Wildcard(*)를 사용하지 않습니다.
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_ALLOW_CREDENTIALS=true
# Recovery Command API 전용 관리자 Key입니다. 실제 Secret은 .env에만 설정합니다.
RECOVERY_ADMIN_API_KEY=
RECOVERY_ADMIN_PRINCIPAL=recovery-admin
RECOVERY_ARTIFACT_DIR=data/recovery/baseline

# Database
DATABASE_URL=sqlite:///./backend/data/iot_security.db

# MQTT
# Raspberry Pi 내부에서 subscriber를 실행할 때는 localhost를 사용합니다.
# Windows PC 또는 ESP32 기준 MQTT broker 주소는 192.168.0.20:1883 입니다.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_NORMAL_TOPIC=iot/+/sensor
MQTT_SUBSCRIBE_TOPIC=iot/+/sensor
MQTT_SUBSCRIBER_USERNAME=
MQTT_SUBSCRIBER_PASSWORD=
MQTT_TEST_TOOL_USERNAME=
MQTT_TEST_TOOL_PASSWORD=

# Detection
FEATURE_WINDOW_SECONDS=10
# MQTT Feature Producer Runtime의 Cycle 간격입니다. 10초 Window보다 짧게 두어
# 닫힌 Window를 늦지 않게 집어가도록 합니다.
MQTT_FEATURE_BUILDER_INTERVAL_SECONDS=5
# 비워두면 DB 파일 옆에 <db>.mqtt-feature-builder.lock 으로 생성됩니다.
MQTT_FEATURE_BUILDER_LOCK_PATH=

# Detection Orchestrator
# ENABLED_STAGES는 이 Cycle에서 실행할 Stage, REQUIRED_STAGES는 완료 Barrier에
# 포함되는 Stage입니다. Required Stage가 cutoff까지 완료되지 않으면 Trust를
# 호출하지 않습니다. Packet Rule을 운영할 때는 enabled·required 양쪽에
# packet_rule을 추가합니다. packet_if는 아래 Artifact 경로·Version·SHA256을
# 모두 설정하고 배포 검증을 마친 뒤에만 추가합니다.
ORCHESTRATOR_ENABLED_STAGES=mqtt_feature_rule,mqtt_message_rule
ORCHESTRATOR_REQUIRED_STAGES=mqtt_feature_rule,mqtt_message_rule
ORCHESTRATOR_INTERVAL_SECONDS=5
# 비워두면 DB 파일 옆에 <db>.orchestrator.lock 으로 생성됩니다.
ORCHESTRATOR_LOCK_PATH=
INITIAL_TRUST_SCORE=100
ISOLATION_THRESHOLD=30

# Gateway Metrics
GATEWAY_METRICS_INTERVAL_SECONDS=10
INTERNAL_LAN_INTERFACE=eth0
USB_LAN_INTERFACE=eth1

# Packet Capture
CAPTURE_INTERFACE_IP=192.168.0.20

# Capture Policy
# 값을 바꾸면 PACKET_MIN_CAPTURE_DURATION_SECONDS도 10.0 - PCAP_MAX_START_DELAY_SECONDS에
# 맞춰 함께 조정해야 합니다. Pi Pilot 측정 근거 없이 임의로 바꾸지 않습니다.
PCAP_MAX_START_DELAY_SECONDS=1.0
PACKET_MIN_CAPTURE_DURATION_SECONDS=9.0
CAPTURE_TIME_EPSILON_SECONDS=0.01
CAPTURE_POLICY_VERSION=packet-capture-policy-v1

# Packet Rule Policy
# 아래 임계값은 Pi Pilot의 P95/P99가 확정되기 전까지의 잠정 기준입니다.
# 임계값 또는 탐지 예외 정책을 변경할 때는 PACKET_RULE_POLICY_VERSION도 함께
# 올려서 Evidence에 어떤 Policy Version으로 판정됐는지 남깁니다.
PACKET_RULE_PACKET_RATE_THRESHOLD=50.0
PACKET_RULE_BYTE_RATE_THRESHOLD=100000.0
PACKET_RULE_PORT_SCAN_DISTINCT_PORT_THRESHOLD=15
PACKET_RULE_PORT_SCAN_SYN_THRESHOLD=15
PACKET_RULE_BROKER_DOS_TCP_SYN_THRESHOLD=30
PACKET_RULE_BROKER_DOS_MQTT_PACKET_THRESHOLD=100
# 쉼표로 구분한 관리 Peer IP는 PACKET_RATE_ANOMALY에서만 제외합니다.
# PCAP/Packet Feature 수집 및 다른 Packet Rule은 그대로 유지됩니다.
PACKET_RULE_PACKET_RATE_EXCLUDED_PEER_IPS=
PACKET_RULE_POLICY_VERSION=packet-rule-policy-v2

# Packet Isolation Forest
# 최종 학습 Artifact를 배포한 Version Directory와 Metadata의 model_version입니다.
PACKET_IF_ARTIFACT_DIR=ai/models/packet_if/packet-if-v1
PACKET_IF_EXPECTED_MODEL_VERSION=packet-if-v1
# 학습 CLI가 출력한 외부 신뢰 기준입니다. Artifact 내부 값으로 대체하지 않습니다.
PACKET_IF_EXPECTED_BUNDLE_SHA256=

# Firewall Worker
# Protected IP는 어떤 경우에도 차단하지 않습니다. Pi #1(CAPTURE_INTERFACE_IP)은
# 설정하지 않아도 자동으로 포함되며, Broker·관리자 노트북 IP를 여기에 추가합니다.
FIREWALL_PROTECTED_IPS=192.168.0.20,192.168.0.2
FIREWALL_WORKER_INTERVAL_SECONDS=5
FIREWALL_WORKER_BATCH_SIZE=20
FIREWALL_RETRY_DELAY_SECONDS=30
# root 소유 Wrapper 경로입니다. sudoers는 이 파일만 허용합니다.
FIREWALL_WRAPPER_PATH=/usr/local/sbin/hanium-firewall-rule
FIREWALL_SUDO_PATH=/usr/bin/sudo
FIREWALL_COMMAND_TIMEOUT_SECONDS=10
# 상시 서비스와 관리자 명령이 같은 Lock을 공유합니다. 비워두면 DB 파일 옆에
# <db>.firewall.lock 으로 생성됩니다.
FIREWALL_LOCK_PATH=
FIREWALL_LOCK_WAIT_SECONDS=15
# Firewall Worker가 실제 INPUT Chain을 read-only로 관찰한 결과를 원자적으로 기록합니다.
# FastAPI는 이 파일만 읽으며 sudo/iptables를 직접 실행하지 않습니다.
FIREWALL_RUNTIME_SNAPSHOT_PATH=data/runtime/firewall-runtime.json
# 기본 Worker 주기 5초의 3배. 이보다 오래된 Snapshot은 Recovery Preflight에서 HOLD합니다.
FIREWALL_RUNTIME_SNAPSHOT_MAX_AGE_SECONDS=15
