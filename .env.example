# Backend
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/iot_security.db

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_NORMAL_TOPIC=devices/+/telemetry
MQTT_ATTACK_TOPIC=attack/#

# Detection
FEATURE_WINDOW_SECONDS=10
TRUST_SCORE_INITIAL=100
TRUST_SCORE_ISOLATION_THRESHOLD=50
