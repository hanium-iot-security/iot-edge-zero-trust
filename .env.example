# Backend
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./backend/data/iot_security.db

# MQTT
# Raspberry Pi 내부에서 subscriber를 실행할 때는 localhost를 사용합니다.
# Windows PC 또는 ESP32 기준 MQTT broker 주소는 192.168.0.20:1883 입니다.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_NORMAL_TOPIC=iot/+/sensor
MQTT_SUBSCRIBE_TOPIC=iot/+/sensor

# Detection
FEATURE_WINDOW_SECONDS=10
INITIAL_TRUST_SCORE=100
ISOLATION_THRESHOLD=30

# Gateway Metrics
GATEWAY_METRICS_INTERVAL_SECONDS=10
INTERNAL_LAN_INTERFACE=eth0
USB_LAN_INTERFACE=eth1

# Packet Capture
CAPTURE_INTERFACE_IP=192.168.0.20
